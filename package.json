{
  "name": "@costkits/costkits-mcp",
  "version": "2.0.0",
  "mcpName": "io.github.costkits/costkits-mcp",
  "description": "Free hosted MCP server for CostKits: live US healthcare procedure cost estimates, provider pricing, and coverage rules for Claude, ChatGPT, or any MCP client. No API key.",
  "license": "MIT",
  "author": {
    "name": "John Caruso",
    "email": "hello@costkits.com",
    "url": "https://www.costkits.com/about/"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "costkits-mcp": "src/server.js"
  },
  "files": [
    "src/"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "start:http": "node src/http.js",
    "smoke": "node scripts/smoke-test.js",
    "smoke:http": "node scripts/smoke-test-http.js",
    "smoke:lambda": "node scripts/smoke-test-lambda.js"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "modelcontextprotocol",
    "healthcare",
    "healthcare-costs",
    "price-transparency",
    "medical-billing",
    "claude",
    "ai-agents"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/costkits/costkits-mcp.git"
  },
  "homepage": "https://www.costkits.com/api/",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0"
  }
}
